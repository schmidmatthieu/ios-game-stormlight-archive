# ===============================================
# Cosmere Chronicles — Production Environment
# ===============================================
# Copy to .env and fill in values:
#   cp .env.production.example .env

# -- PostgreSQL --
DB_USER=cosmere
DB_PASSWORD=CHANGE_ME_GENERATE_STRONG_PASSWORD
DB_NAME=cosmere

# -- Auth --
# Generate with: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_GENERATE_STRONG_SECRET

# -- CORS --
CORS_ALLOWED_ORIGINS=https://cosmere.ark.swiss
